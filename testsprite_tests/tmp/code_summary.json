  "features": [
    {
      "name": "User Authentication & Management",
      "description": "Comprehensive user authentication system with JWT tokens, OTP verification, password reset, and role-based access control",
      "files": [
        "server/auth.ts",
        "server/user-management-routes.ts",
        "server/otp-registration-routes.ts",
        "server/email-link-registration.ts",
        "server/company-auth-routes.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "User Authentication API",
          "version": "1.0.0"
        },
        "paths": {
          "/api/auth/login": {
            "post": {
              "summary": "User login",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "email": {"type": "string"},
                        "password": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          },
          "/api/auth/register": {
            "post": {
              "summary": "User registration"
            }
          },
          "/api/auth/otp/verify": {
            "post": {
              "summary": "OTP verification"
            }
          }
        }
      }
    },
    {
