{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\" -k --names \"SERVER,CLIENT\"",
    "dev:simple": "cross-env NODE_ENV=development npx nodemon",
    "dev:all": "kill-port 3000 3002 && concurrently \"npm:dev:server\" \"npm:dev:client\" -k --names \"SERVER,CLIENT\"",
    "dev:sequential": "kill-port 3000 3002 && npm run dev:server & sleep 3 && npm run dev:client",
    "dev:reliable": "kill-port 3000 3002 && concurrently \"npm:dev:server\" \"npm:dev:client-wait\" -k --names \"SERVER,CLIENT\"",
    "dev:server": "cross-env NODE_ENV=development npx nodemon",
    "dev:client": "npx vite",
    "dev:client-wait": "wait-on http://localhost:3000 && npm run dev:client",
    "build": "vite build && esbuild server/index.ts --platform=node --bundle --format=cjs --outfile=dist/index.cjs --external:canvas --external:sharp --external:lightningcss --external:@babel/preset-typescript --external:bcrypt --external:nodemailer --external:speakeasy --external:qrcode --external:drizzle-orm --external:postgres --external:node-fetch --external:multer --external:express --external:passport --external:jsonwebtoken --external:fsevents --external:dotenv --external:fs --external:path --external:crypto --external:util --external:stream --external:buffer --external:os --external:child_process --external:net --external:tls --external:http --external:https --external:events --external:url --external:querystring --external:zlib --external:jsdom --external:isomorphic-dompurify --external:dompurify --external:xhr-sync-worker --external:whatwg-url --external:tough-cookie --external:ws --external:parse5 --external:saxes --external:w3c-xmlserializer --external:xml-name-validator --external:webidl-conversions --external:cssom --external:cssstyle --external:data-urls --external:domexception --external:form-data --external:html-encoding-sniffer --external:http-proxy-agent --external:https-proxy-agent --external:nwsapi --external:request --external:symbol-tree --external:abab --external:acorn --external:acorn-globals --external:escodegen --external:left-pad --external:pn --external:tr46 --external:uuid --external:optionator --external:source-map --external:webpack --external:esbuild --external:vite --external:openvidu-node-client --external:@aws-sdk/client-s3 --external:@aws-sdk/s3-request-presigner && mkdir -p dist/public && cp -r client/dist/* dist/public/",
    "build:production": "npm run build:clean && npm run build:client && npm run build:server && npm run build:copy",
    "build:clean": "rm -rf dist client/dist",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --platform=node --bundle --format=cjs --outfile=dist/index.cjs --external:canvas --external:sharp --external:lightningcss --external:@babel/preset-typescript --external:bcrypt --external:nodemailer --external:speakeasy --external:qrcode --external:drizzle-orm --external:postgres --external:node-fetch --external:multer --external:express --external:passport --external:jsonwebtoken --external:fsevents --external:dotenv --external:fs --external:path --external:crypto --external:util --external:stream --external:buffer --external:os --external:child_process --external:net --external:tls --external:http --external:https --external:events --external:url --external:querystring --external:zlib --external:jsdom --external:isomorphic-dompurify --external:dompurify --external:xhr-sync-worker --external:whatwg-url --external:tough-cookie --external:ws --external:parse5 --external:saxes --external:w3c-xmlserializer --external:xml-name-validator --external:webidl-conversions --external:cssom --external:cssstyle --external:data-urls --external:domexception --external:form-data --external:html-encoding-sniffer --external:http-proxy-agent --external:https-proxy-agent --external:nwsapi --external:request --external:symbol-tree --external:abab --external:acorn --external:acorn-globals --external:escodegen --external:left-pad --external:pn --external:tr46 --external:uuid --external:optionator --external:source-map --external:webpack --external:esbuild --external:vite --external:openvidu-node-client --external:@aws-sdk/client-s3 --external:@aws-sdk/s3-request-presigner",
    "build:copy": "mkdir -p dist/public && cp -r client/dist/* dist/public/ && echo 'Build completed successfully'",
    "start": "NODE_ENV=production node dist/index.cjs",
    "start:production": "npm run build && npm start",
    "start:production-split": "concurrently \"npm:start:server\" \"npm:start:client\" -k --names \"API,CLIENT\"",
    "start:server": "NODE_ENV=production SERVE_STATIC_FILES=false node dist/index.cjs",
    "start:client": "npx vite preview --host 0.0.0.0 --port 3002",
    "start:client-only": "npx vite preview --host 0.0.0.0 --port 3002",
    "preview": "npm run build && npm run start:production",
    "deploy:production": "npm run build:production && npm run start",
    "validate:deployment": "node scripts/validate-deployment.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "migrate:guest-session": "npx tsx scripts/add-guest-session-fields.ts",
    "email:test": "npx tsx scripts/test-email-connection.ts",
    "email:resend": "npx tsx scripts/resend-invitation.ts",
    "email:list-signers": "npx tsx scripts/list-signer-links.ts",
    "url:test": "npx tsx scripts/test-url-config.ts",
    "evs:test": "npx tsx scripts/test-evs-real-integration.ts",
    "db:migrate": "node scripts/run-migrations.mjs migrate",
    "db:migrate:single": "node scripts/run-migrations.mjs single",
    "db:test": "node scripts/run-migrations.mjs test",
    "job:fix": "npx tsx run-job-integrity-fix.ts",
    "job:validate": "npx tsx scripts/validate-job-integrity.ts",
    "job:stats": "npx tsx scripts/show-job-stats.ts",
    "notary:assign": "npx tsx scripts/assign-missing-notaries.ts",
    "participants:add": "npx tsx scripts/add-default-participants.ts",
    "email:validate": "npx tsx scripts/validate-email-system.ts",
    "system:validate": "npm run email:validate && npm run job:validate",
    "setup": "chmod +x scripts/setup-environment.sh && ./scripts/setup-environment.sh",
    "setup:env": "node -e \"console.log('Setting up environment...'); require('fs').writeFileSync('.env', require('fs').readFileSync('scripts/setup-environment.sh', 'utf8').split('cat > .env << EOF')[1].split('EOF')[0]);\"",
    "setup:quick": "npm install && npm run db:test && npm run evs:test",
    "setup:certificates": "npx tsx scripts/setup-certificates.ts"
  },
