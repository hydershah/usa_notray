# Add directories or file patterns to ignore during indexing (e.g. foo/ or *.csv)
# Note: .env files are allowed for Cursor indexing even though they're in .gitignore
# This allows the AI to read environment variables while keeping them secure from git

# Explicitly DO NOT ignore .env files (override .gitignore behavior for Cursor)
!.env*

# You can add other patterns to ignore here:
# node_modules/
# dist/
# build/
