#!/usr/bin/env node

/**
 * Test script to verify admin auto-approval of notaries
 * This script tests both admin-created and self-registered notaries
 */

const jwt = require('jsonwebtoken');

// Mock test data
const TEST_ADMIN_USER = {
  id: 1,
  email: 'admin@test.com',
  role: 'admin'
};

const TEST_NOTARY_DATA = {
  fullName: 'Test Notary',
  email: 'test.notary@example.com',
  phoneNumber: '+1234567890',
  password: 'TestPassword123!',
  userType: 'notary',
  address1: '123 Test St',
  city: 'Test City',
  state: 'CA',
  zipCode: '12345',
  notaryType: 'contractor'
};

const JWT_SECRET = process.env.JWT_SECRET || 'your-secret-key';

async function testAdminNotaryCreation() {
  console.log('🧪 Testing Admin Notary Auto-Approval Implementation');
  console.log('=' .repeat(60));

  // Generate admin token
  const adminToken = jwt.sign(TEST_ADMIN_USER, JWT_SECRET, { expiresIn: '1h' });
  console.log('✅ Generated admin token for testing');

  // Test 1: Admin creates notary (should be auto-approved)
  console.log('\n📋 Test 1: Admin creates notary (should be auto-approved)');
  try {
    const response = await fetch('http://localhost:3000/api/auth/register-user', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${adminToken}`
      },
      body: JSON.stringify({
        ...TEST_NOTARY_DATA,
        email: 'admin.created.notary@example.com'
      })
    });

    if (response.ok) {
      const result = await response.json();
      console.log('✅ Admin-created notary response:', result);
      if (result.approvalStatus === 'approved' && result.isActive === true) {
        console.log('🎉 SUCCESS: Admin-created notary was auto-approved!');
      } else {
        console.log('❌ FAILURE: Admin-created notary was not auto-approved');
        console.log('   Expected: approvalStatus="approved", isActive=true');
        console.log('   Actual:', { approvalStatus: result.approvalStatus, isActive: result.isActive });
      }
    } else {
      const error = await response.text();
      console.log('❌ Request failed:', response.status, error);
    }
  } catch (error) {
    console.log('❌ Test 1 failed:', error.message);
  }

  // Test 2: Self-registration (should require approval)
  console.log('\n📋 Test 2: Self-registration via register-notary (should require approval)');
  try {
    const response = await fetch('http://localhost:3000/api/auth/register-notary', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        firstName: 'Self',
        lastName: 'Registered',
        email: 'self.registered.notary@example.com',
        phoneNumber: '+1234567890',
        password: 'TestPassword123!',
        address1: '123 Test St',
        city: 'Test City',
        state: 'CA',
        zipCode: '12345',
        dateOfBirth: '1990-01-01',
        commissionNumber: 'TEST123',
        commissionState: 'CA',
        commissionExpiration: '2025-12-31',
        yearsOfExperience: '5',
        notaryType: 'contractor'
      })
    });

    if (response.ok) {
      const result = await response.json();
      console.log('✅ Self-registered notary response:', result.user);
      if (result.user.approvalStatus === 'pending' && result.user.isActive === false) {
        console.log('🎉 SUCCESS: Self-registered notary requires approval as expected!');
      } else {
        console.log('❌ FAILURE: Self-registered notary approval status is incorrect');
        console.log('   Expected: approvalStatus="pending", isActive=false');
        console.log('   Actual:', { approvalStatus: result.user.approvalStatus, isActive: result.user.isActive });
      }
    } else {
      const error = await response.text();
      console.log('❌ Request failed:', response.status, error);
    }
  } catch (error) {
    console.log('❌ Test 2 failed:', error.message);
  }

  // Test 3: Regular user creates notary (no token - should require approval)
  console.log('\n📋 Test 3: Regular user creates notary via register-user (should require approval)');
  try {
    const response = await fetch('http://localhost:3000/api/auth/register-user', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
        // No Authorization header
      },
      body: JSON.stringify({
        ...TEST_NOTARY_DATA,
        email: 'regular.created.notary@example.com'
      })
    });

    if (response.ok) {
      const result = await response.json();
      console.log('✅ Regular user-created notary response:', result);
      if (result.approvalStatus === 'pending' && result.isActive === false) {
        console.log('🎉 SUCCESS: Regular user-created notary requires approval as expected!');
      } else {
        console.log('❌ FAILURE: Regular user-created notary approval status is incorrect');
        console.log('   Expected: approvalStatus="pending", isActive=false');
        console.log('   Actual:', { approvalStatus: result.approvalStatus, isActive: result.isActive });
      }
    } else {
      const error = await response.text();
      console.log('❌ Request failed:', response.status, error);
    }
  } catch (error) {
    console.log('❌ Test 3 failed:', error.message);
  }

  console.log('\n' + '=' .repeat(60));
  console.log('🏁 Testing completed');
}

// Run tests if this script is executed directly
if (require.main === module) {
  testAdminNotaryCreation().catch(console.error);
}

module.exports = { testAdminNotaryCreation };
