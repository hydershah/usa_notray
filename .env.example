# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Custom SSL Certificate Authority (for enterprise databases)
# DB_SSL_CA=/path/to/ca-certificate.crt

# Environment
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET=your-jwt-secret-key

# File Upload Configuration
VULTR_ACCESS_KEY=your-vultr-access-key
VULTR_SECRET_KEY=your-vultr-secret-key
VULTR_REGION=your-region
VULTR_BUCKET_NAME=your-bucket-name
VULTR_ENDPOINT=your-vultr-endpoint

# Email Configuration
EMAIL_PROVIDER=postmark
POSTMARK_API_KEY=your-postmark-api-key
POSTMARK_FROM_EMAIL=noreply@yourdomain.com
POSTMARK_FROM_NAME=Your Company Name

# Client URL for CORS
CLIENT_URL=http://localhost:3000 