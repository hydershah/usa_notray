# USA Notary Platform - Staging Environment
NODE_ENV=staging
PORT=3000

# Database (staging database)
DATABASE_URL=your_staging_database_url

# Frontend URLs
CLIENT_URL=https://usa-notray-staging.fly.dev
SERVER_URL=https://usa-notray-staging.fly.dev
FRONTEND_URL=https://usa-notray-staging.fly.dev
BACKEND_URL=https://usa-notray-staging.fly.dev

# JWT Configuration
JWT_SECRET=your_staging_jwt_secret

# Vultr Object Storage (same as production or separate bucket)
VULTR_ACCESS_KEY=your_vultr_access_key
VULTR_SECRET_KEY=your_vultr_secret_key
VULTR_REGION=ewr1
VULTR_BUCKET_NAME=usa-notary-staging-documents
VULTR_ENDPOINT=https://ewr1.vultrobjects.com

# Email Configuration (staging - can use same as production)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password
EMAIL_FROM=USA Notary Staging <staging@yourdomain.com>

# Redis (staging Redis instance)
REDIS_URL=your_staging_redis_url

# External APIs (use test/sandbox keys for staging)
EVS_API_KEY=your_test_evs_api_key
EVS_PASSWORD=your_test_evs_password
EVS_ENVIRONMENT=sandbox

STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key

# Debug settings for staging
DEBUG_MODE=true
LOG_LEVEL=debug 