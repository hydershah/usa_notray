# Vultr Object Storage Configuration
# Get these credentials from: https://my.vultr.com/objectstorage/
VULTR_ACCESS_KEY=your_actual_vultr_access_key_here
VULTR_SECRET_KEY=your_actual_vultr_secret_key_here
VULTR_REGION=ewr1
VULTR_BUCKET_NAME=usa-notary-documents
VULTR_ENDPOINT=https://ewr1.vultrobjects.com

# Instructions:
# 1. Go to https://my.vultr.com
# 2. Navigate to Products → Object Storage
# 3. Enable Object Storage if not already enabled
# 4. Go to Account → API to get your Object Storage keys
# 5. Replace the placeholder values above with your actual credentials
